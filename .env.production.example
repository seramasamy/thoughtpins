# Thought Pins production deployment template

ENVIRONMENT=production
VOICE_ARCHIVE_ENABLED=false
TRANSCRIPTION_PROVIDER=hosted
TRANSCRIPTION_API_KEY=replace-with-transcription-service-key
TRANSCRIPTION_BASE_URL=replace-with-openai-compatible-transcription-base-url
TRANSCRIPTION_MODEL=replace-with-transcription-model
TRANSCRIPTION_LOCAL_MODEL=base
TRANSCRIPTION_TIMEOUT_SECONDS=120
APP_NAME=Thought Pins
API_VERSION=0.2.0

PRIVACY_POLICY_URL=https://thoughtpins.com/privacy
TERMS_URL=https://thoughtpins.com/terms
SUPPORT_URL=https://thoughtpins.com/support
ACCOUNT_DELETION_URL=https://thoughtpins.com/account/delete
AI_DISCLOSURE_URL=https://thoughtpins.com/ai-disclosure
LEGAL_DOCUMENT_VERSION=2026-07-13
MIN_IOS_VERSION=1.0.0
MIN_ANDROID_VERSION=1.0.0
MIN_WEB_VERSION=1.0.0
RECOMMENDED_IOS_VERSION=1.0.0
RECOMMENDED_ANDROID_VERSION=1.0.0
RECOMMENDED_WEB_VERSION=1.0.0
IOS_STORE_URL=https://apps.apple.com/app/thought-pins/id0000000000
ANDROID_STORE_URL=https://play.google.com/store/apps/details?id=com.thoughtpins.app
WEB_APP_URL=https://thoughtpins.com/app
MAINTENANCE_MODE=false
MAINTENANCE_MESSAGE=Thought Pins is in maintenance for a short upgrade. Please try again soon.
MAINTENANCE_RETRY_AFTER_SECONDS=300
MAINTENANCE_ALLOW_READS=true

REQUIRE_API_AUTH=true
API_KEY=replace-with-long-random-bootstrap-key-32chars-minimum
ALLOW_USER_API_KEYS=false
RETURN_API_KEY_ON_REGISTER=false
JWT_SECRET=replace-with-long-random-jwt-secret-32chars-minimum
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_DAYS=30

DATABASE_URL=postgresql+psycopg2://thoughtpins:replace-password@postgres:5432/thoughtpins
AUTO_CREATE_TABLES=false
DB_POOL_SIZE=10
DB_MAX_OVERFLOW=20
DB_POOL_RECYCLE_SECONDS=1800

REDIS_URL=redis://redis:6379/0
RATE_LIMIT_ENABLED=true
RATE_LIMIT_PER_MINUTE=120
RATE_LIMIT_AUTH_PER_MINUTE=5
RATE_LIMIT_INGEST_PER_MINUTE=30
RATE_LIMIT_LLM_PER_MINUTE=20
RATE_LIMIT_EXPORT_PER_MINUTE=10
RATE_LIMIT_ACCOUNT_PER_MINUTE=30
PROCESS_ENTRIES_ASYNC=true
INGESTION_WORKER_THREADS=4
INGESTION_STALE_AFTER_MINUTES=30
INGESTION_QUEUE_BACKEND=celery
INGESTION_MAX_RETRIES=3
CELERY_BROKER_URL=redis://redis:6379/1
CELERY_RESULT_BACKEND=redis://redis:6379/2
CELERY_WORKER_CONCURRENCY=2
CELERY_QUEUE_NAME=celery
WORKER_HEARTBEAT_TTL_SECONDS=120
WORKER_RECOVERY_INTERVAL_SECONDS=60
METRICS_REQUIRE_AUTH=true

GOOGLE_OAUTH_CLIENT_IDS=
APPLE_OAUTH_CLIENT_IDS=
APPLE_OAUTH_TEAM_ID=
APPLE_OAUTH_KEY_ID=
APPLE_OAUTH_PRIVATE_KEY_PATH=/run/secrets/apple-sign-in-key.p8
APPLE_OAUTH_REDIRECT_URIS=https://thoughtpins.com/app/
APPLE_OAUTH_TIMEOUT_SECONDS=10
VITE_GOOGLE_CLIENT_ID=
VITE_APPLE_CLIENT_ID=
ALLOW_OAUTH_REGISTRATION=false
REQUIRE_EMAIL_VERIFICATION=false
EMAIL_VERIFICATION_TOKEN_TTL_HOURS=24

SENTRY_DSN=replace-with-sentry-dsn
JSON_LOGS=true
CORS_ALLOW_ORIGINS=https://thoughtpins.com

LLM_PROVIDER=openai_compatible
LLM_API_KEY=replace-with-llm-api-key
LLM_BASE_URL=replace-with-openai-compatible-base-url
LLM_MODEL=replace-with-chat-model
LLM_FALLBACK_MODEL=replace-with-fallback-model
LLM_EXTRACTION_MODEL=replace-with-extraction-model
LLM_THINKING=disabled
LLM_SUPPORTS_THINKING=false
LLM_REASONING_EFFORT=high
LLM_TIMEOUT_SECONDS=60
LLM_MAX_RETRIES=2
LLM_EMPTY_RESPONSE_RETRIES=3
LLM_HEALTHCHECK_LIVE=false

SYSTEM_LOCKED=true
ENABLE_TELEGRAM_BOT=false
TELEGRAM_BOT_TOKEN=
TELEGRAM_ALLOWED_USER_IDS=
TELEGRAM_TEST_MODE=false
ENABLE_FOUNDER_MODE=false
FOUNDER_ACCESS_CODE=
CONFIDENTIAL_ACCESS_CODE=replace-with-private-mode-code

LOCAL_TIMEZONE=America/New_York
VAULT_PATH=/var/lib/thoughtpins/vault
VAULT_IMPORT_PATH=/var/lib/thoughtpins/vault_imports
VAULT_IMPORT_SESSION_HOURS=24
VAULT_UPLOAD_CHUNK_BYTES=524288
REPORTS_PATH=/var/lib/thoughtpins/reports
BACKUPS_PATH=/var/lib/thoughtpins/backups
CONVERSATION_CACHE_PATH=/var/lib/thoughtpins/conversation_cache.json
QDRANT_PATH=/var/lib/thoughtpins/qdrant
QDRANT_URL=http://qdrant:6333
QDRANT_API_KEY=replace-with-long-random-qdrant-key
QDRANT_TIMEOUT_SECONDS=10
VECTOR_MODE=qdrant_remote
EMBEDDING_PROVIDER=openai
OPENAI_API_KEY=replace-with-openai-api-key
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_EMBEDDING_MODEL=text-embedding-3-small
OPENAI_EMBEDDING_DIMENSIONS=1536
VECTOR_HEALTHCHECK_LIVE=true
PRIVATE_ALLOW_LLM=false
DATA_ENCRYPTION_KEY=replace-with-fernet-key-from-python-m-thoughtpins-crypto
SECURITY_HEADERS_ENABLED=true
MAX_REQUEST_BODY_BYTES=1048576
RUN_STARTUP_RECOVERY=false

# Article/document ingestion. Start with local,jina for the cheapest compliant
# public-link path; enable Firecrawl or Apify only after provider billing is set.
ARTICLE_FETCH_PROVIDERS=local,jina
ARTICLE_ALLOW_PRIVATE_URLS=false
ARTICLE_FETCH_TIMEOUT_SECONDS=20
ARTICLE_MAX_FETCH_BYTES=3000000
ARTICLE_MIN_TEXT_CHARS=500
ARTICLE_USER_AGENT=ThoughtPins/1.0 public memory reader
OPEN_ACCESS_RESOLUTION_ENABLED=true
OPEN_ACCESS_CONTACT_EMAIL=support@thoughtpins.com
OPEN_ACCESS_BASE_URL=https://api.unpaywall.org/v2
OPEN_ACCESS_TIMEOUT_SECONDS=12
JINA_API_KEY=
FIRECRAWL_API_KEY=
FIRECRAWL_BASE_URL=https://api.firecrawl.dev/v2
APIFY_API_TOKEN=
APIFY_BASE_URL=https://api.apify.com/v2
APIFY_READER_ACTOR=
APIFY_READER_INPUT_TEMPLATE=
