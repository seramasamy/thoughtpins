{
  "name": "thoughtpins-frontend",
  "version": "1.0.0-rc.1",
  "private": true,
  "type": "module",
  "scripts": {
    "check": "tsc --noEmit -p tsconfig.json",
    "build": "npm run check && node scripts/build.mjs",
    "dev": "vite --configLoader native --host 127.0.0.1",
    "vite:build": "vite build --configLoader native",
    "preview": "vite preview --host 127.0.0.1",
    "smoke:web": "playwright test",
    "smoke:pwa": "playwright test --config playwright.pwa.config.ts",
    "smoke:web:headed": "playwright test --headed",
    "smoke:live": "node scripts/capture-live.mjs",
    "smoke:site": "node scripts/capture-site.mjs",
    "smoke:cross-browser": "node scripts/cross-browser-audit.mjs",
    "capture:product-assets": "node scripts/capture-product-assets.mjs",
    "design:review-capture": "node scripts/capture-design-review.mjs",
    "install:playwright": "playwright install chromium"
  },
  "dependencies": {
    "@fontsource-variable/newsreader": "^5.3.0",
    "@fontsource-variable/source-sans-3": "^5.3.0",
    "@vitejs/plugin-react": "^6.0.5",
    "lucide-react": "^1.31.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "typescript": "^7.0.2",
    "vite": "^8.2.1"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.12.1",
    "@playwright/test": "^1.61.1",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4"
  }
}
