                                               },
                              "vault_store":  {
                                                  "required":  true,
                                                  "persistent_volume":  "thoughtpins-vault",
                                                  "export_format":  "obsidian_vault"
                                              },
                              "reports_store":  {
                                                    "required":  true,
                                                    "persistent_volume":  "thoughtpins-reports"
                                                }
                          },
    "required_runtime_flags":  {
