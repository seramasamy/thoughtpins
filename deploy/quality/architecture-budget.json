{
  "schema_version": 1,
  "source_roots": [
    "src/thoughtpins",
    "frontend/src",
    "site",
    "mobile/ios/ThoughtPinsApp/Sources",
    "mobile/android/thoughtpins-app/src/main/kotlin"
  ],
  "default_line_limits": {
    ".py": 700,
    ".ts": 600,
    ".tsx": 600,
    ".css": 1000,
    ".swift": 800,
    ".kt": 800
  },
  "legacy_line_budgets": {
    "src/thoughtpins/api.py": 364,
    "src/thoughtpins/bot/commands.py": 455
  },
  "dependency_rules": [
    {
      "name": "core layers do not depend on transports",
      "paths": [
        "src/thoughtpins/memory",
        "src/thoughtpins/ingestion",
        "src/thoughtpins/vault",
        "src/thoughtpins/llm",
        "src/thoughtpins/reports",
        "src/thoughtpins/chat"
      ],
      "forbidden_import_prefixes": [
        "thoughtpins.api",
        "thoughtpins.api_routes",
        "thoughtpins.bot",
        "thoughtpins.founder"
      ],
      "exceptions": [
        {
          "path": "src/thoughtpins/chat/actions.py",
          "import": "thoughtpins.founder.ops",
          "reason": "TD-002. Chat no longer imports the Telegram adapter; this is the one remaining cross-layer reach, and it is a different concern from the one that item names. chat/actions.py calls founder.ops.build_doctor_report to answer a diagnostics request. Declared so it stays visible and no new violation can be added silently."
        }
      ]
    }
  ]
}
