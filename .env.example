# Thought Pins Backend Configuration

ENVIRONMENT=development
APP_NAME=Thought Pins
API_VERSION=1.0.0-rc.1

# Public URLs shown in web/native clients. Production validation requires these.
PRIVACY_POLICY_URL=
TERMS_URL=
SUPPORT_URL=
ACCOUNT_DELETION_URL=
AI_DISCLOSURE_URL=
LEGAL_DOCUMENT_VERSION=2026-07-13
MIN_IOS_VERSION=0.0.0
MIN_ANDROID_VERSION=0.0.0
MIN_WEB_VERSION=0.0.0
RECOMMENDED_IOS_VERSION=1.0.0
RECOMMENDED_ANDROID_VERSION=1.0.0
RECOMMENDED_WEB_VERSION=1.0.0
IOS_STORE_URL=
ANDROID_STORE_URL=
WEB_APP_URL=/app
MAINTENANCE_MODE=false
MAINTENANCE_MESSAGE=Thought Pins is in maintenance for a short upgrade. Please try again soon.
MAINTENANCE_RETRY_AFTER_SECONDS=300
MAINTENANCE_ALLOW_READS=true

# Local development can run without auth. Set REQUIRE_API_AUTH=true before any shared deploy.
REQUIRE_API_AUTH=false
API_KEY=change-me-for-admin-bootstrap
ALLOW_USER_API_KEYS=true
RETURN_API_KEY_ON_REGISTER=true
JWT_SECRET=change-me-to-a-long-random-string
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_DAYS=30
RATE_LIMIT_ENABLED=false
RATE_LIMIT_PER_MINUTE=120
RATE_LIMIT_AUTH_PER_MINUTE=5
RATE_LIMIT_INGEST_PER_MINUTE=30
RATE_LIMIT_LLM_PER_MINUTE=20
RATE_LIMIT_EXPORT_PER_MINUTE=10
RATE_LIMIT_ACCOUNT_PER_MINUTE=30
PROCESS_ENTRIES_ASYNC=false
INGESTION_WORKER_THREADS=2
INGESTION_STALE_AFTER_MINUTES=30
INGESTION_QUEUE_BACKEND=thread
INGESTION_MAX_RETRIES=3
CELERY_BROKER_URL=
CELERY_RESULT_BACKEND=
CELERY_WORKER_CONCURRENCY=2
CELERY_QUEUE_NAME=celery
WORKER_HEARTBEAT_TTL_SECONDS=120
WORKER_RECOVERY_INTERVAL_SECONDS=60
METRICS_REQUIRE_AUTH=false
GOOGLE_OAUTH_CLIENT_IDS=
APPLE_OAUTH_CLIENT_IDS=
# Apple server credentials are required only when Apple sign-in is enabled.
APPLE_OAUTH_TEAM_ID=
APPLE_OAUTH_KEY_ID=
APPLE_OAUTH_PRIVATE_KEY_PATH=
APPLE_OAUTH_REDIRECT_URIS=
APPLE_OAUTH_TIMEOUT_SECONDS=10
VITE_GOOGLE_CLIENT_ID=
VITE_APPLE_CLIENT_ID=
ALLOW_OAUTH_REGISTRATION=false
REQUIRE_EMAIL_VERIFICATION=false
EMAIL_VERIFICATION_TOKEN_TTL_HOURS=24

# Current code uses synchronous SQLAlchemy. Use psycopg2 for PostgreSQL until
# the async database layer is implemented.
DATABASE_URL=sqlite:///./data/thoughtpins.sqlite3
# DATABASE_URL=postgresql+psycopg2://user:password@localhost:5432/thoughtpins
DB_POOL_SIZE=5
DB_MAX_OVERFLOW=10
AUTO_CREATE_TABLES=true

REDIS_URL=redis://localhost:6379/0
SENTRY_DSN=
JSON_LOGS=false
CORS_ALLOW_ORIGINS=http://localhost:3000

# Any OpenAI-compatible endpoint works; only these four values change between
# providers. Two that publish a zero-retention policy for open models:
#
#   Fireworks  LLM_BASE_URL=https://api.fireworks.ai/inference/v1
#              LLM_MODEL=accounts/fireworks/models/<model-id>
#              Retention is off by default for open models and logging is opt-in,
#              so a forgotten setting fails safe. SOC 2 Type II and HIPAA.
#
#   Together   LLM_BASE_URL=https://api.together.xyz/v1
#              LLM_MODEL=<org>/<model-id>
#              Zero retention is OPT-IN: turn it on under Privacy & Security
#              before sending anything real, because the default retains.
#
# Sending journal text to a model vendor's own endpoint is a separate decision
# from choosing its weights. Open weights served by a provider above stay under
# that provider's policy; the vendor's first-party API does not.
LLM_PROVIDER=openai_compatible
LLM_API_KEY=
LLM_BASE_URL=replace-with-openai-compatible-base-url
LLM_MODEL=replace-with-chat-model
LLM_FALLBACK_MODEL=replace-with-fallback-model
LLM_EXTRACTION_MODEL=replace-with-extraction-model
# Required in production for every runtime named above. The spend cap is
# computed from this, so an unpriced model meters at LLM_DEFAULT_* and lets real
# spend run past the cap. Prices move: copy them from the provider, not here.
# LLM_PRICING_JSON={"accounts/fireworks/models/example":{"input_per_1m":3.0,"output_per_1m":15.0}}
LLM_PRICING_JSON={}
LLM_THINKING=disabled
LLM_SUPPORTS_THINKING=false
LLM_REASONING_EFFORT=high
LLM_TIMEOUT_SECONDS=180
LLM_MAX_RETRIES=2
LLM_EMPTY_RESPONSE_RETRIES=3
LLM_EXTRACTION_MAX_TOKENS=6144
MEMORY_CONTEXT_MODE=smart
MEMORY_CONTEXT_MAX_CHARS=850000
MEMORY_CONTEXT_FULL_INLINE_MAX_CHARS=180000
MEMORY_CONTEXT_RELEVANT_MEMORIES=80
MEMORY_CONTEXT_RECENT_MEMORIES=60
MEMORY_CONTEXT_RECENT_ENTRIES=25
LLM_HEALTHCHECK_LIVE=false

# Voice transcription can run locally or through a deployment-selected,
# OpenAI-compatible hosted processor. Hosted mode requires its own explicit key.
TRANSCRIPTION_PROVIDER=local
TRANSCRIPTION_API_KEY=
TRANSCRIPTION_BASE_URL=https://api.openai.com/v1
TRANSCRIPTION_MODEL=whisper-1
TRANSCRIPTION_LOCAL_MODEL=base
TRANSCRIPTION_TIMEOUT_SECONDS=120

# Article/document ingestion. Use local,jina for the cheapest public-link path.
# Firecrawl and Apify are paid/advanced fallbacks for public pages and sites
# you have permission to process. Restricted articles should be pasted/uploaded.
ARTICLE_FETCH_PROVIDERS=local
ARTICLE_ALLOW_PRIVATE_URLS=false
ARTICLE_FETCH_TIMEOUT_SECONDS=20
ARTICLE_MAX_FETCH_BYTES=3000000
ARTICLE_MIN_TEXT_CHARS=500
ARTICLE_USER_AGENT=ThoughtPins/0.2 local memory reader
ARTICLE_RESTRICTED_DOMAINS=wsj.com,bloomberg.com,economist.com,ft.com,nytimes.com,washingtonpost.com,theatlantic.com,newyorker.com,barrons.com,marketwatch.com,foreignaffairs.com,technologyreview.com,statnews.com,scientificamerican.com
OPEN_ACCESS_RESOLUTION_ENABLED=true
OPEN_ACCESS_CONTACT_EMAIL=support@thoughtpins.com
OPEN_ACCESS_BASE_URL=https://api.unpaywall.org/v2
OPEN_ACCESS_TIMEOUT_SECONDS=12
JINA_API_KEY=
FIRECRAWL_API_KEY=
FIRECRAWL_BASE_URL=https://api.firecrawl.dev/v2
APIFY_API_TOKEN=
APIFY_BASE_URL=https://api.apify.com/v2
APIFY_READER_ACTOR=
APIFY_READER_INPUT_TEMPLATE=
LIBRARY_EXTRACT_GRAPH=false
LIBRARY_GRAPH_EXTRACT_MAX_CHARS=12000
MEMORY_HYBRID_KEYWORD_CANDIDATES=3000
MEMORY_HYBRID_GRAPH_HOPS=1
MEMORY_HYBRID_GRAPH_RESULTS=25
GRAPH_PROVIDER=internal_sql
GRAPH_SHADOW_ENABLED=false
GRAPHITI_DRIVER=kuzu
GRAPHITI_KUZU_PATH=./data/graphiti.kuzu
GRAPHITI_NEO4J_URI=
GRAPHITI_NEO4J_USER=
GRAPHITI_NEO4J_PASSWORD=
GRAPHITI_FALKOR_HOST=localhost
GRAPHITI_FALKOR_PORT=6379
GRAPHITI_FALKOR_USERNAME=
GRAPHITI_FALKOR_PASSWORD=
GRAPHITI_FALKOR_DATABASE=thoughtpins
GRAPHITI_TELEMETRY_ENABLED=false

API_HOST=127.0.0.1
API_PORT=8420
LOG_LEVEL=INFO
SECURITY_HEADERS_ENABLED=true
MAX_REQUEST_BODY_BYTES=1048576
RUN_STARTUP_RECOVERY=true

SYSTEM_LOCKED=true
DEFAULT_ADMIN_EMAIL=
DEFAULT_DISPLAY_NAME=Local Admin

# Telegram is optional legacy ingestion, disabled unless explicitly configured.
ENABLE_TELEGRAM_BOT=false
TELEGRAM_BOT_TOKEN=
TELEGRAM_ALLOWED_USER_IDS=
TELEGRAM_TEST_MODE=false
ENABLE_FOUNDER_MODE=false
FOUNDER_ACCESS_CODE=
CONFIDENTIAL_ACCESS_CODE=
DEFAULT_TELEGRAM_CHAT_ID=

LOCAL_TIMEZONE=America/New_York
VAULT_PATH=./vault
VAULT_IMPORT_PATH=./data/vault_imports
VAULT_IMPORT_SESSION_HOURS=24
VAULT_UPLOAD_CHUNK_BYTES=524288
# Optional private/self-hosted feature. Keep false in public store builds until
# account-scoped personal voice functionality is available in that release.
VOICE_ARCHIVE_ENABLED=false
VOICE_ARCHIVE_PATH=./data/voice_archive
REPORTS_PATH=./reports
BACKUPS_PATH=./backups
CONVERSATION_CACHE_PATH=./data/conversation_cache.json
QDRANT_PATH=./data/qdrant
# Staging and production use qdrant_remote so API and worker processes share
# one authenticated service. QDRANT_PATH remains the local founder default.
QDRANT_URL=
QDRANT_API_KEY=
QDRANT_TIMEOUT_SECONDS=10
VECTOR_MODE=qdrant_local
# Options: openai, local, llm. Use openai for a production-grade hosted
# embedding model; LLM_PROVIDER controls chat/reasoning separately.
EMBEDDING_PROVIDER=llm
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_EMBEDDING_MODEL=text-embedding-3-small
OPENAI_EMBEDDING_DIMENSIONS=1536
VECTOR_HEALTHCHECK_LIVE=false
PRIVATE_ALLOW_LLM=false
DATA_ENCRYPTION_KEY=
